generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Availability {
  AVAILABLE
  OUT_OF_STOCK
  ASK_SELLER
}

enum InquiryStatus {
  NEW
  CONTACTED
  RESOLVED
  SPAM
}

model Category {
  id          String    @id @default(cuid())
  nameAr      String
  nameFr      String?
  slug        String    @unique
  description String?
  imageUrl    String?
  position    Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, position])
}

model Product {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  description     String?
  sku             String       @unique
  brand           String?
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price           Decimal?     @db.Decimal(10, 2)
  salePrice       Decimal?     @db.Decimal(10, 2)
  showPrice       Boolean      @default(false)
  availability    Availability @default(ASK_SELLER)
  published       Boolean      @default(false)
  featured        Boolean      @default(false)
  isSample        Boolean      @default(false)
  images          ProductImage[]
  specifications  ProductSpec[]
  compatibility   Compatibility[]
  inquiries       Inquiry[]
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?

  @@index([published, archivedAt, createdAt])
  @@index([categoryId, published])
  @@index([availability, published])
  @@index([name, sku])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  position  Int     @default(0)

  @@index([productId, position])
}

model Compatibility {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand     String?
  model     String
  verified  Boolean @default(false)

  @@index([productId, verified])
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String
  phone         String
  message       String
  status        InquiryStatus @default(NEW)
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  ipHash        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  resolvedAt    DateTime?

  @@index([status, createdAt])
  @@index([productId, createdAt])
  @@index([createdAt])
}

model StoreSettings {
  id              String   @id @default("store")
  businessName    String   @default("سكوتر بييس")
  logoUrl         String?
  whatsappPhone   String?
  contactPhone    String?
  contactEmail    String?
  location        String?
  mapUrl          String?
  openingHours    String?
  deliveryInfo    String?
  currency        String   @default("MAD")
  showPrices      Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}